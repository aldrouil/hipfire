+///     -- --ignored --nocapture pinned_input_ready
+#[test]
+#[ignore = "requires HIP GPU"]
+fn pinned_input_ready_marker_semantics() -> Result<(), Box<dyn std::error::Error>> {
+    let mut gpu = Gpu::init()?;
